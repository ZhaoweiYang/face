{
  "name": "voicecard-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VoiceCard on Cloudflare Workers (D1 + R2)",
  "scripts": {
    "dev": "wrangler d1 migrations apply voicecard-db --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply voicecard-db --remote && wrangler deploy",
    "cards": "node scripts/cards.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
