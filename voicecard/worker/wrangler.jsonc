{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voicecard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The same front-end as the Python server (voicecard/static). The Worker runs first
  // for every request so it can add security headers and route /c/<token>.
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voicecard-db",
      "database_id": "2067ae2a-3e3e-4166-a9df-a6a2dd628281",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "voicecard-audio" }],

  // Per Cloudflare location; period must be 10 or 60 seconds. namespace_id only
  // needs to be unique within the account.
  "ratelimits": [
    // Unknown card tokens per IP: ~10 guesses a minute against a 2^128 space.
    { "name": "RL_MISS", "namespace_id": "7101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_API", "namespace_id": "7102", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "7103", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_REGISTER", "namespace_id": "7104", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "7105", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    "SESSION_DAYS": "30",
    "MAX_SECONDS": "180",
    "MAX_AUDIO_MB": "10",
    "MAX_MESSAGES": "50",
    // Password hashing cost (Workers caps PBKDF2 at 100000). ~50 ms of CPU per
    // login; on the Workers Free plan (10 ms CPU) lower it if logins fail with 1102.
    "PBKDF2_ITERATIONS": "100000"
  }

  // Custom domain (recommended; *.workers.dev is unreliable from mainland China):
  // "routes": [{ "pattern": "voice.example.com", "custom_domain": true }]
}
